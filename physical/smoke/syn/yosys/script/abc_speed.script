# Speed ABC recipe adapted from OpenROAD-flow-scripts flow/scripts/abc_speed.script.
# Source: The-OpenROAD-Project/OpenROAD-flow-scripts, BSD-3-Clause.
# Every &nf mapping step receives the shared {D} period constraint.

&get -n
&st
&dch
&nf {D}
&st
&syn2
&if -g -K 6
&synch2
&nf {D}
&st
&syn2
&if -g -K 6
&synch2
&nf {D}
&st
&syn2
&if -g -K 6
&synch2
&nf {D}
&st
&syn2
&if -g -K 6
&synch2
&nf {D}
&st
&syn2
&if -g -K 6
&synch2
&nf {D}
&put
buffer -c
topo
stime -c
upsize -c
dnsize -c
