; Blank before every blocking refill, then shift 16 column/row bits.
.program led_scan
.entry scan
.wrap_bottom scan
.wrap_top again
.in 0, 0
.out 19, 1
.set 16, 3
.tx_bits 16, right, manual
.rx_bits 32, right, manual
.test none, 0
.packing 1, 0, 16
.clock_ticks 4, stretchable
scan: SET_PIN 4
FIFO PULL, BLOCKING
OUT PINS, 1
SET_PIN 1
SET_PIN 0
SET_COUNT X, 15
bit: OUT PINS, 1
SET_PIN 1
SET_PIN 0
BRANCH DEC_X_NONZERO, bit
SET_PIN 6
SET_PIN 0
CTRL NOP [7]
again: BRANCH ALWAYS, scan
