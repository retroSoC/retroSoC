; Mode-0 eight-bit full-duplex frame; CS is SET window bit 1.
.program spi_master
.entry idle
.wrap_bottom idle
.wrap_top again
.in 7, 1
.out 6, 1
.set 4, 2
.tx_bits 8, right, manual
.rx_bits 8, right, auto
.test none, 0
.packing 1, 1, 8
.clock_ticks 5, stretchable
idle: SET_PIN 2
frame: FIFO PULL, BLOCKING
SET_PIN 0
OUT PINS, 1
SET_PIN 1
IN PINS, 1
SET_PIN 0
SET_COUNT X, 7
bit: OUT PINS, 1
SET_PIN 1
IN PINS, 1
SET_PIN 0
BRANCH DEC_X_NONZERO, bit
SET_PIN 2
again: BRANCH ALWAYS, frame
