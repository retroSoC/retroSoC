; Latch once, then clock eight data samples into one automatic RX word.
.program gamepad
.entry scan
.wrap_bottom scan
.wrap_top again
.in 22, 1
.out 0, 0
.set 20, 2
.tx_bits 32, right, manual
.rx_bits 8, right, auto
.test none, 0
.packing 0, 1, 8
.clock_ticks 4, stretchable
scan: SET_PIN 2
SET_PIN 0
IN PINS, 1
SET_PIN 1
SET_PIN 0
SET_COUNT X, 7
bit: IN PINS, 1
SET_PIN 1
SET_PIN 0
BRANCH DEC_X_NONZERO, bit
again: BRANCH ALWAYS, scan
