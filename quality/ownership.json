{
  "schema_version": 1,
  "review_policy": {
    "mode": "sole_maintainer",
    "self_approval_allowed": true,
    "agent_approval_allowed": true,
    "required_approving_review_count": 0,
    "require_code_owner_reviews": false,
    "rationale": "Only @maksyuki can review PRs. CI-green auto-merge is explicitly authorized with merge commits and safe cleanup; agents never bypass checks, dirty worktrees, or non-canonical branches."
  },
  "auto_merge": {
    "enabled": true,
    "strategy": "merge_commit",
    "require_green_checks": true,
    "cleanup_merged_branches": true,
    "allow_dirty_worktree": false
  },
  "entries": [
    {"path": "/Makefile", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/dependencies/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/configs/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/scripts/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/.agents/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/.github/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/quality/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/rtl/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/crt/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/app/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/tests/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/physical/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/docs/", "owners": ["@maksyuki"], "backup_owners": []},
    {"path": "/publications/", "owners": ["@maksyuki"], "backup_owners": []}
  ]
}
