{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrosoc.invalid/schemas/agent-task-v1.json",
  "title": "retroSoC agent task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_class",
    "base_revision",
    "scope",
    "acceptance",
    "validation",
    "execution",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "task_class": {
      "enum": ["feature", "fix", "docs", "tooling", "dependency", "review", "release"]
    },
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_socs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["TINY", "MINI", "STD", "PRO"]}
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision"],
      "properties": {
        "path": {"type": "string"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "phase": {"type": "string"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "allowed_paths", "forbidden_paths", "non_goals"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "allowed_paths": {"type": "array", "items": {"type": "string"}},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "mode", "profiles", "pdks"],
      "properties": {
        "risk": {"enum": ["low", "medium", "high"]},
        "mode": {"enum": ["fast", "affected", "full"]},
        "profiles": {"type": "array", "items": {"type": "string"}},
        "pdks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["IHP130", "ICS55", "GF180", "SKY130"]}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "worktree", "artifact_root"],
      "properties": {
        "mode": {"enum": ["read-only", "workspace-write"]},
        "worktree": {"type": "string", "minLength": 1},
        "artifact_root": {"type": "string", "pattern": "^build/"},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved_by", "reference", "plan_sha256"],
          "properties": {
            "approved_by": {"type": "string", "minLength": 1},
            "reference": {"type": "string", "minLength": 1},
            "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "status": {
      "enum": ["planned", "approved", "in_progress", "blocked", "review", "done"]
    },
    "resolves_gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "coordination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depends_on",
        "inputs",
        "outputs",
        "write_set",
        "lease",
        "idempotency_key",
        "budget",
        "retry",
        "attempt",
        "integrator",
        "allow_parallel"
      ],
      "properties": {
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^build/"}
        },
        "write_set": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "ttl_seconds"],
          "properties": {
            "owner": {"type": "string", "minLength": 1},
            "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          }
        },
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout_seconds", "max_runner_minutes"],
          "properties": {
            "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
            "max_runner_minutes": {"type": "integer", "minimum": 1, "maximum": 10080}
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "backoff_seconds", "categories"],
          "properties": {
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
            "backoff_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
            "categories": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["infrastructure_failure"]}
            }
          }
        },
        "attempt": {"type": "integer", "minimum": 1},
        "resume_from": {"type": "string", "pattern": "^build/"},
        "integrator": {"type": "string", "minLength": 1},
        "allow_parallel": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "uri", "status"],
        "properties": {
          "kind": {"type": "string"},
          "uri": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "SKIPPED", "NOT_RUN"]}
        }
      }
    }
  }
}
