{
  "xpi": {
    "document": "docs/ip/xpi.md",
    "defines": [
      "rtl/ip/storage/xpi_define.svh"
    ],
    "rtl": [
      "rtl/ip/storage/xpi_reg.sv",
      "rtl/ip/storage/xpi_pkg.sv"
    ],
    "parameters": {},
    "groups": [
      {
        "id": "main",
        "title": "Global XPI registers",
        "pattern": "APB4_XPI__(?!SLOT_|LUT_).+",
        "strip": "^APB4_XPI__",
        "base": 0,
        "stride": 0,
        "count": 1
      },
      {
        "id": "slot",
        "title": "Chip-select slots",
        "pattern": "APB4_XPI__SLOT_.+",
        "strip": "^APB4_XPI__SLOT_",
        "base": 256,
        "stride": 32,
        "count": 4,
        "exclude": [
          "APB4_XPI__SLOT_BASE",
          "APB4_XPI__SLOT_STRIDE"
        ]
      },
      {
        "id": "lut",
        "title": "LUT words",
        "pattern": "(?!)",
        "strip": "^",
        "base": 512,
        "stride": 4,
        "count": 64
      }
    ],
    "field_aliases": {
      "IRQ_STATE": [
        "APB4_XPI__IRQ_"
      ],
      "IRQ_ENABLE": [
        "APB4_XPI__IRQ_"
      ],
      "IRQ_TEST": [
        "APB4_XPI__IRQ_"
      ],
      "INTR_STATE": [
        "XPI_INTR_"
      ],
      "INTR_ENABLE": [
        "XPI_INTR_"
      ],
      "INTR_STATUS": [
        "XPI_INTR_"
      ]
    },
    "extra": [
      {
        "group": "lut",
        "name": "LUT_WORD",
        "offset": 0,
        "access": "RW / locked",
        "reset": "Boot LUT; other sequences STOP",
        "description": "Two 16-bit instructions. Sequence n begins at word 4*n; PC7 must terminate or jump on CS. Bits 9:8 of each halfword are reserved.",
        "fields": [
          {
            "name": "OPERAND0",
            "lsb": 0,
            "msb": 7,
            "description": "Instruction operand.",
            "reset": "Register reset applies",
            "expression": "reviewed semantic field"
          },
          {
            "name": "Reserved",
            "lsb": 8,
            "msb": 9,
            "description": "Reserved; preserve zero when writing.",
            "reset": "0",
            "expression": "reserved"
          },
          {
            "name": "PADS0",
            "lsb": 10,
            "msb": 11,
            "description": "0 = one pad, 1 = two pads, 2 = four pads; 3 is invalid.",
            "reset": "Register reset applies",
            "expression": "reviewed semantic field"
          },
          {
            "name": "OPCODE0",
            "lsb": 12,
            "msb": 15,
            "description": "0 STOP, 1 CMD, 2 ADDR, 3 MODE, 4 DUMMY, 5 TX, 6 RX, 7 JUMP_ON_CS.",
            "reset": "Register reset applies",
            "expression": "reviewed semantic field"
          },
          {
            "name": "OPERAND1",
            "lsb": 16,
            "msb": 23,
            "description": "Instruction operand.",
            "reset": "Register reset applies",
            "expression": "reviewed semantic field"
          },
          {
            "name": "Reserved",
            "lsb": 24,
            "msb": 25,
            "description": "Reserved; preserve zero when writing.",
            "reset": "0",
            "expression": "reserved"
          },
          {
            "name": "PADS1",
            "lsb": 26,
            "msb": 27,
            "description": "0 = one pad, 1 = two pads, 2 = four pads; 3 is invalid.",
            "reset": "Register reset applies",
            "expression": "reviewed semantic field"
          },
          {
            "name": "OPCODE1",
            "lsb": 28,
            "msb": 31,
            "description": "0 STOP, 1 CMD, 2 ADDR, 3 MODE, 4 DUMMY, 5 TX, 6 RX, 7 JUMP_ON_CS.",
            "reset": "Register reset applies",
            "expression": "reviewed semantic field"
          }
        ]
      }
    ],
    "support": [
      "rtl/ip/storage/apb4_xpi.sv",
      "rtl/ip/storage/xpi_clkgen.sv",
      "rtl/ip/storage/xpi_core.sv",
      "rtl/ip/storage/xpi_if.sv",
      "rtl/ip/storage/xpi_indirect.sv",
      "rtl/ip/storage/xpi_mm.sv"
    ],
    "memory_map": "rtl/tiny/address_map/memory_map.json"
  },
