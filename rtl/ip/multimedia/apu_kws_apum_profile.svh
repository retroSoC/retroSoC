function automatic logic [1:0] apu_kws_apum_fixed_word_check(input logic [14:0] offset_i,
                                                             input logic [31:0] data_i);
  logic        valid;
  logic [10:0] index;
  begin
    valid = 1'b0;
    index = 11'd0;
    if ((offset_i <= 15'h04fc) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd0 + 11'((offset_i - 15'h0000) >> 2);
    end else if ((offset_i >= 15'h1000) && (offset_i <= 15'h11fc) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd320 + 11'((offset_i - 15'h1000) >> 2);
    end else if ((offset_i >= 15'h1540) && (offset_i <= 15'h173c) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd448 + 11'((offset_i - 15'h1540) >> 2);
    end else if ((offset_i >= 15'h2840) && (offset_i <= 15'h2a3c) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd576 + 11'((offset_i - 15'h2840) >> 2);
    end else if ((offset_i >= 15'h2d80) && (offset_i <= 15'h2f7c) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd704 + 11'((offset_i - 15'h2d80) >> 2);
    end else if ((offset_i >= 15'h4080) && (offset_i <= 15'h427c) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd832 + 11'((offset_i - 15'h4080) >> 2);
    end else if ((offset_i >= 15'h45c0) && (offset_i <= 15'h47bc) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd960 + 11'((offset_i - 15'h45c0) >> 2);
    end else if ((offset_i >= 15'h58c0) && (offset_i <= 15'h5abc) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd1088 + 11'((offset_i - 15'h58c0) >> 2);
    end else if ((offset_i >= 15'h5e00) && (offset_i <= 15'h5ffc) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd1216 + 11'((offset_i - 15'h5e00) >> 2);
    end else if ((offset_i >= 15'h7100) && (offset_i <= 15'h72fc) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd1344 + 11'((offset_i - 15'h7100) >> 2);
    end else if ((offset_i >= 15'h7630) && (offset_i <= 15'h768c) && (offset_i[1:0] == 2'd0)) begin
      valid = 1'b1;
      index = 11'd1472 + 11'((offset_i - 15'h7630) >> 2);
    end
    apu_kws_apum_fixed_word_check = valid ? {1'b1, data_i == apu_kws_apum_fixed_word(index)} :
        2'b00;
  end
endfunction
