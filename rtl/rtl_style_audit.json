  "reviewed_boundaries": [
    {
      "paths": [
        "rtl/ip/experimental/axi4f2ribp.sv",
        "rtl/ip/experimental/apb4_gpu.sv",
        "rtl/ip/experimental/wb2ribp.sv"
      ],
      "result": "inactive experimental source",
      "rationale": "The modules remain primary-unit-aligned but are not active filelist inputs. Incomplete protocol behavior was not changed by style work."
    },
    {
      "paths": [
        "rtl/ip/memory/psram_core.sv",
        "rtl/ip/memory/sdram_core.sv",
        "rtl/ip/multimedia/dvp_core.sv",
        "rtl/ip/multimedia/dvp_reg.sv",
        "rtl/ip/storage/xpi_mm.sv"
      ],
      "result": "raw sequential storage retained",
      "rationale": "Reset and update priorities, SPI/SDRAM timing, or inferred-memory behavior are cycle-sensitive. Replacing these processes with Common register primitives requires a separate sequential-equivalence proof and affected protocol simulation."
    },
    {
      "paths": [
        "rtl/ip/util/async_fifo.sv"
      ],
      "result": "retained implementation",
      "rationale": "Dual-clock storage, Gray-pointer synchronization, and inferred-memory behavior cannot be replaced by single-clock Common registers without equivalence evidence."
    },
    {
      "paths": [
        "rtl/ip/usb/apb4_usb2.sv",
        "rtl/ip/usb/usb2_link_domain.sv",
        "rtl/ip/usb/usb2_packet_ram.sv"
      ],
      "result": "reviewed CDC and technology-memory boundary",
      "rationale": "The system/ULPI boundary uses managed request-acknowledge synchronizers, asynchronous FIFOs, level synchronizers, and event toggles. Packet RAM retains a single-port technology wrapper with SECDED encoding; replacement requires CDC and memory-equivalence evidence."
    },
    {
      "paths": [
        "rtl/mini/top/axi4_interconnect.sv"
      ],
      "result": "retained implementation",
      "rationale": "Priority-sensitive master, target, and performance state arrays remain unchanged pending separate sequential-equivalence proof."
    },
    {
      "paths": [
        "rtl/mini/top/onchip_ram.sv",
        "rtl/mini/top/onchip_ram_reg.sv"
      ],
      "result": "reviewed AXI and technology-memory boundary",
      "rationale": "AXI and APB state uses Common registers; the synchronous bank array retains the stable technology wrapper and PDK SRAM pin boundary."
    },
    {
      "paths": [
        "rtl/mini/top/soc_common_cdc.sv",
        "rtl/mini/top/soc_common_fifo.sv"
      ],
      "result": "managed compatibility wrapper retained",
      "rationale": "The narrow self-owned wrappers preserve required Verilator filename behavior while including managed Common source."
    },
    {
      "paths": [
        "rtl/mini/top/user_core_design.sv",
        "rtl/mini/top/user_ip_design_template.sv"
      ],
      "result": "external template compatibility retained",
      "rationale": "Template interfaces remain stable for externally distributed user designs."
    }
  ]
