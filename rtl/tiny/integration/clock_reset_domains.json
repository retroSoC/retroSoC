{
  "schema_version": 2,
  "external_fabric": {
    "phase": "TINY-R2-P7",
    "clock_domain": "system",
    "target_controllers": "u_soc.u_fabric.gen_target[%d].u_controller",
    "target_count": 28,
    "apb_bridges": "SYS frontends; acknowledged per-endpoint crossings to AON, PCLK and MEM",
    "fabric_reset": "fabric leaf; target reset blocks admission and aborts accepted target work with DECERR",
    "hart_reset": "CPU-only accepted-work drain; DMA and all target responses stay active",
    "runtime_peripheral_reset": "RCU blocks admissions, drains accepted work, holds reset for five local edges, waits for local release and bus barriers"
  },
  "local_memory": {
    "phase": "TINY-R2-P4",
    "clock_domain": "system",
    "cpu_instance": "u_soc.u_cpu.u_hazard3_cpu_2port",
    "frontend_instance": "u_soc.u_cpu_mem",
    "macro_instance": "u_soc.u_sram.gen_group[{group}].u_group.gen_bank[{bank}].u_ram.u_mem",
    "groups": 4,
    "macros_per_group": 8,
    "hart_reset": "halt then drain accepted I/D and slow responses; SRAM/DMA stay active",
    "main_sram_payload_reset": "none",
    "local_uncontended_max_cycles": 3
  },
  "reset_ports": [
    "ext_rst_n_i_pad",
    "jtag_trst_n_i_pad"
  ],
  "domains": [
