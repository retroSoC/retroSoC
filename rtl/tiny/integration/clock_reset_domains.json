      "instance": "u_ref_rst",
      "sta": {
        "source_port": "extclk_i_pad",
        "pin": "u_clock_buffer/clk_o",
        "period_ns": 41.666666667,
        "async_group": "core"
      }
    },
    {
      "name": "system",
      "clock": "s_backend_sys_clk",
      "reset": "system_rst_n_o",
      "reset_source": "s_system_req_n",
      "reset_primitive": "rst_sync",
      "path": "rtl/tiny/top/tiny_reset_tree.sv",
      "instance": "u_system_rst_sync",
      "sta": {
        "source_domain": "aon",
        "pin": "u_soc.u_clock_backend.u_sys_mux/clk_o",
        "period_ns": 41.666666667,
        "async_group": "core"
      }
    },
    {
      "name": "memory",
      "clock": "s_backend_mem_clk",
      "reset": "s_backend_mem_rst_n",
      "reset_source": "rst_n_i",
      "reset_primitive": "rst_sync",
      "path": "rtl/tiny/top/tiny_clock_reset_subsystem.sv",
      "instance": "u_mem_rst",
      "sta": {
        "source_domain": "system",
        "pin": "u_soc.u_clock_backend.u_mem_mux/clk_o",
        "period_ns": 41.666666667,
        "async_group": "core"
      }
    },
    {
      "name": "peripheral",
      "clock": "s_backend_pclk",
      "reset": "pclk_rst_n_o",
      "reset_source": "rst_n_i",
      "reset_primitive": "rst_sync",
      "path": "rtl/tiny/top/tiny_clock_reset_subsystem.sv",
      "instance": "u_pclk_rst",
      "sta": {
        "source_domain": "system",
        "pin": "u_soc.u_clock_backend.u_pclk_mux/clk_o",
        "period_ns": 41.666666667,
        "async_group": "core"
      }
    },
    {
