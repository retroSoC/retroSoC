      "reset_primitive": "rst_sync",
      "path": "rtl/ip/core/mgmt_debug_wrapper.sv",
      "instance": "u_jtag_rst_sync",
      "sta": {
        "source_port": "jtag_tck_i_pad",
        "object_type": "port",
        "period_ns": 100,
        "async_group": "jtag"
      }
    },
    {
      "name": "audio",
      "clock": "s_audio_clk",
      "reset": "s_audio_rst_n",
      "reset_source": "s_i2s_rst_n",
      "reset_primitive": "rst_sync",
      "path": "rtl/tiny/top/retrosoc_tiny.sv",
      "instance": "u_audio_rst_sync",
      "sta": {
        "source_port": "gpio_17_io_pad",
        "pin": "u_soc.u_audio_clock_buffer/clk_o",
        "period_ns": 54.253472222,
        "async_group": "audio"
      }
