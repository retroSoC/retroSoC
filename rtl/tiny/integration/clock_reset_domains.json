  "reset_distribution": {
    "release_edges": 5,
    "por": "u_soc.u_reset_tree.u_por_rst_sync",
    "system": "u_soc.u_reset_tree.u_system_rst_sync",
    "system_source": "por_rst_n_o && !watchdog_reset_req_i && backend_reset_n_i",
    "leaf_instance_pattern": "u_soc.u_reset_tree.gen_leaf[%d].u_leaf_rst_sync",
    "leaf_names": [
      "fabric",
      "gpio",
      "uart0",
      "timer0",
      "timer1",
      "i2c0",
      "xpi",
      "dma",
      "sysctrl",
      "clint",
