      "wdg",
      "rng",
      "crc",
      "ws2812",
      "crypto",
      "i2s",
      "sdio",
      "dvp"
    ],
    "cpu_prerequisite": "all global leaf resets and actual APB/DMA/XPI/RCU barriers; boot readiness latches until the next system reset",
    "hart": "u_soc.u_cpu.u_mgmt_debug_wrapper.u_mgmt_debug_reset.u_core_rst_sync",
    "jtag": "u_soc.u_cpu.u_mgmt_debug_wrapper.u_jtag_rst_sync",
    "dmi": "u_soc.u_cpu.u_mgmt_debug_wrapper.u_dmi_rst_sync",
    "watchdog_functional_reset": "REF24 five-edge release after backend retains the watchdog reset event; PCLK APB uses the wdg leaf",
    "main_sram_payload_reset": "none",
    "crypto": "six private macro banks; reset invalidates then scrubs/readbacks; CPU does not wait for READY",
    "clock_domain": "domain-specific",
    "peripheral": "tiny_peripheral_leaf; five running hold edges and five release edges; I2S additionally requires actual audio-side barrier readiness"
  },
